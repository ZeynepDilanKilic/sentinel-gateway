{
  "server": {
    "listen": ":8080",
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s",
    "shutdown_timeout": "15s"
  },
  "routes": [
    { "name": "users",  "path_prefix": "/api/users", "upstream": "http://127.0.0.1:9001", "strip_prefix": true },
    { "name": "orders", "path_prefix": "/api/orders", "upstream": "http://127.0.0.1:9002", "strip_prefix": false }
  ]
}
